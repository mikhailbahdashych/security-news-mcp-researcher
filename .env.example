# Your Anthropic API key. Read from here at startup (or from the real process
# environment, which wins), and never written to the database — so this is an
# alternative to entering it on the app's Settings page, not a copy of it.
ANTHROPIC_API_KEY=

DB_PATH=./data/app.db

# Your Voyage AI key, for the knowledge base's embeddings. Same rules as the
# Anthropic key: read from here at startup (or from the real process environment,
# which wins), never written to the database, and only ever read back masked. With
# no key the knowledge base stays a keyword index (SQLite FTS5) and works fine;
# entering one later embeds the backlog through Settings -> Knowledge -> Embed now.
VOYAGE_API_KEY=

# The port the API binds. Read through app.config.Settings, so it works from
# here as well as from the real environment — `make dev-api`, `docker compose up`
# and `python -m app` all honour it.
PORT=8000

# Extra browser origins allowed to call the API, comma-separated. Empty is right
# for both supported ways of running this: in Docker the SPA is same-origin, and
# `make dev-web` proxies /api through Vite. Only a browser on some *other* origin
# needs this, e.g. CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=

# Application log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
