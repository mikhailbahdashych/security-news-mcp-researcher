# API keys are NOT here. The Anthropic key and the Voyage key live in the
# database, are entered on the app's Settings page and are read back only masked.

DB_PATH=./data/app.db

# The port the API binds. Read through app.config.Settings, so it works from
# here as well as from the real environment — `make dev-api` and `python -m app`
# both honour it.
PORT=8000

# Application log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
